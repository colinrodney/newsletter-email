<mjml>
  <mj-head>
    <mj-title>Hello MJML</mj-title>
    <mj-font name="Roboto" href="https://googleapis.com" />
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, sans-serif" />
    </mj-attributes>
  </mj-head>

  <!-- Email Body -->
  <mj-body>
  <!-- Hero / Header Section -->
  <mj-wrapper background-color="#E7E7F1">
    <mj-hero
    mode="fluid-height"
      background-width="600px"
      background-height="469px"
      background-url=
          "https://i.postimg.cc/1X5pSrjj/newsletter-hero-6d39823e-8630-749a-8ef2-f8cad5c55808.png"
      background-color="#E7E7F1">
    </mj-hero>
    <mj-section background-color="#E7E7F1">
        <mj-column>
            <mj-image src="https://i.postimg.cc/J04b852y/newsletter-internet-header-41a90663-29d3-7bc3-c865-103cbc996347.png">
            </mj-image>
        </mj-column>
    </mj-section>
    <mj-section background-color="#E7E7F1" padding-top="100px">
        <mj-column>
            <mj-image src="https://i.postimg.cc/LXVzGbN1/second-divisor-b9592cdf-618b-1e76-af09-433bb4f8e425.png">
            </mj-image>
        </mj-column>
    </mj-section>
  </mj-wrapper>

  <!-- Content / Articles Section -->
  <mj-wrapper background-color="#E7E7F1">
    <!-- Section 1 -->
    <mj-section>
        <mj-group>
        <!-- Section header text-->
            <mj-column width="100%">
                <mj-text>
                <p>Sed ut perspiciatis</p>
                </mj-text>
            </mj-column>
        <!-- Image -->
            <mj-column width="50%">
                <mj-image 
                alt="books"
                src="https://i.postimg.cc/C5Lj0sQv/newsletter-web-culture-f270c3db-4a8e-edbd-1093-18e22fb0ec44.png"
                height="auto">
                </mj-image>
            </mj-column>
            <!-- Text right-->
            <mj-column width="50%">
                <mj-text>
                <p>Sed ut perspiciatis unde omnis iste natus error sit voluptatem 
                accusantium doloremque laudantium, totam rem aperiam,</p>
                </mj-text>
            </mj-column>
            <!-- Bullet points-->
            <mj-column width="100%">
                <mj-text>
                    <ul>
                        <li>Sed ut perspiciatis</li>
                        <li>Sed ut perspiciatis</li>
                        <li>Sed ut perspiciatis</li>
                    </ul>
                </mj-text>
            </mj-column>
        </mj-group>
    </mj-section>

    <!-- Section 2 -->
    <mj-section>
